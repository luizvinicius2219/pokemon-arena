{
  "name": "pokemon-arena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:assets && npm run check:status && npm run check:movement && npm run check:water && npm run check:hitboxes && npm run check:ground && tsc --noEmit && vite build",
    "check:movement": "node scripts/check-movement.mjs && node scripts/check-pewter.mjs",
    "check:hitboxes": "node --experimental-strip-types scripts/check-hitboxes.mjs",
    "check:ground": "node --experimental-strip-types scripts/check-ground-fractures.mjs",
    "check:water": "node --experimental-strip-types scripts/check-water-jet.mjs",
    "check:status": "node scripts/check-status.mjs",
    "preview": "vite preview",
    "check:assets": "node scripts/verify-art.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "gifuct-js": "^2.1.2"
  },
  "devDependencies": {
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
